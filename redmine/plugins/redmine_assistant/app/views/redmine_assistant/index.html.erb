<% html_title(l(:label_redmine_assistant)) %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag(
        'plugin_assets/redmine_assistant/redmine_assistant'
      ) %>
  <%= javascript_include_tag(
        'plugin_assets/redmine_assistant/redmine_assistant_feedback'
      ) %>
<% end %>

<div class="contextual">
  <%= link_to(
        l(:label_redmine_assistant_clear),
        project_redmine_assistant_path(
          project_id: @project.identifier
        ),
        class: 'icon icon-reload'
      ) %>
</div>

<h2><%= l(:label_redmine_assistant) %></h2>

<div class="redmine-assistant-introduction">
  <p>
    <%= l(:text_redmine_assistant_introduction) %>
  </p>

  <ul>
    <li><%= l(:text_redmine_assistant_example_analysis) %></li>
    <li><%= l(:text_redmine_assistant_example_formatting) %></li>
    <li><%= l(:text_redmine_assistant_example_results) %></li>
    <li><%= l(:text_redmine_assistant_example_runtime) %></li>
    <li><%= l(:text_redmine_assistant_example_troubleshooting) %></li>
  </ul>
</div>

<div class="box redmine-assistant-search">
  <%= form_with(
        url: search_project_redmine_assistant_path(
          project_id: @project.identifier
        ),
        method: :post,
        local: true
      ) do %>

    <p>
      <%= label_tag(
            :query,
            l(:label_redmine_assistant_question)
          ) %>

      <%= text_field_tag(
            :query,
            @query,
            maxlength: 2000,
            required: true,
            autofocus: true,
            autocomplete: 'off',
            placeholder: l(
              :text_redmine_assistant_placeholder
            )
          ) %>
    </p>

    <p class="buttons">
      <%= submit_tag(
            l(:button_redmine_assistant_search),
            name: nil
          ) %>
    </p>
  <% end %>
</div>

<% if @query.present? && @results.empty? && flash.now[:error].blank? %>
  <div class="nodata">
    <%= l(:text_redmine_assistant_no_results) %>
  </div>
<% end %>

<% if @results.present? %>
  <h3>
    <%= l(
          :label_redmine_assistant_results,
          count: @results.length
        ) %>
  </h3>

  <div class="redmine-assistant-results">
    <% @results.each do |result| %>
      <article class="box redmine-assistant-result">
        <header class="redmine-assistant-result-header">
          <div>
            <h4>
              <span class="redmine-assistant-rank">
                <%= result['rank'] %>.
              </span>

              <%= result['document_title'] %>
            </h4>

            <p class="redmine-assistant-section">
              <%= redmine_assistant_heading_path(
                    result['heading_path']
                  ) %>
            </p>
          </div>

          <span class="redmine-assistant-score">
            <%= redmine_assistant_score(result['score']) %>
          </span>
        </header>

  <div class="redmine-assistant-content wiki">
    <%= redmine_assistant_content(
          result['content']
        ) %>
  </div>

  <footer class="redmine-assistant-result-footer">
    <strong>
      <%= l(:label_redmine_assistant_source) %>:
    </strong>

    <% source_url = redmine_assistant_source_url(
        result['source_path']
      ) %>

    <% if source_url.present? %>
      <%= link_to(
            result['source_path'],
            source_url,
            class: 'external',
            target: '_blank',
            rel: 'noopener noreferrer'
          ) %>
    <% else %>
      <code><%= result['source_path'] %></code>
    <% end %>
  </footer>
      </article>
    <% end %>
  </div>

  <% if @rag_request_id.present? %>
    <section
      class="box redmine-assistant-feedback"
      data-feedback-url="<%= feedback_project_redmine_assistant_path(
        project_id: @project.identifier
      ) %>"
      data-request-id="<%= @rag_request_id %>"
    >
      <p class="redmine-assistant-feedback-question">
        <%= l(:label_redmine_assistant_feedback) %>
      </p>

      <div class="redmine-assistant-feedback-actions">
        <button
          type="button"
          class="button-positive redmine-assistant-feedback-helpful"
        >
          <%= l(:button_redmine_assistant_helpful) %>
        </button>
        <button
          type="button"
          class="redmine-assistant-feedback-unhelpful"
        >
          <%= l(:button_redmine_assistant_unhelpful) %>
        </button>
      </div>

      <div class="redmine-assistant-feedback-details" hidden>
        <label for="redmine-assistant-feedback-reason">
          <%= l(:label_redmine_assistant_feedback_reason) %>
        </label>
        <select id="redmine-assistant-feedback-reason">
          <option value=""><%= l(:text_redmine_assistant_feedback_choose_reason) %></option>
          <option value="irrelevant_results"><%= l(:text_redmine_assistant_feedback_irrelevant_results) %></option>
          <option value="missing_documentation"><%= l(:text_redmine_assistant_feedback_missing_documentation) %></option>
          <option value="unclear_documentation"><%= l(:text_redmine_assistant_feedback_unclear_documentation) %></option>
          <option value="outdated_documentation"><%= l(:text_redmine_assistant_feedback_outdated_documentation) %></option>
          <option value="insufficient_detail"><%= l(:text_redmine_assistant_feedback_insufficient_detail) %></option>
          <option value="other"><%= l(:text_redmine_assistant_feedback_other) %></option>
        </select>

        <label for="redmine-assistant-feedback-comment">
          <%= l(:label_redmine_assistant_feedback_comment) %>
        </label>
        <textarea
          id="redmine-assistant-feedback-comment"
          maxlength="1000"
          rows="3"
        ></textarea>
        <button
          type="button"
          class="redmine-assistant-feedback-submit"
        >
          <%= l(:button_redmine_assistant_submit_feedback) %>
        </button>
      </div>

      <p class="redmine-assistant-feedback-status" role="status" aria-live="polite"></p>
    </section>
  <% end %>
<% end %>
