#: olc_webportalv2/static/js/dropzone_i18n.js:9
msgid "Drop files to upload or click"
msgstr "Déposez des fichiers pour les téléverser ou cliquez."

#: olc_webportalv2/static/js/dropzone_i18n.js:10
msgid "Your browser does not support drag'n'drop file uploads."
msgstr "Votre navigateur ne prend pas en charge le téléversement de fichiers par glisser-déposer."

#: olc_webportalv2/static/js/dropzone_i18n.js:11
msgid ""
"Please use the fallback form below to upload your files like in the olden "
"days."
msgstr "Veuillez utiliser le formulaire de remplacement ci-dessous pour téléverser vos fichiers."

#: olc_webportalv2/static/js/dropzone_i18n.js:12
msgid "Upload!"
msgstr "Téléverser !"

#: olc_webportalv2/static/js/dropzone_i18n.js:13
msgid "File is too big ({{filesize}}MiB). Max filesize: {{maxFilesize}}MiB."
msgstr "Le fichier est trop volumineux ({{filesize}} Mio). Taille maximale : {{maxFilesize}} Mio."

#: olc_webportalv2/static/js/dropzone_i18n.js:14
msgid "You can't upload files of this type."
msgstr "Vous ne pouvez pas téléverser ce type de fichier."

#: olc_webportalv2/static/js/dropzone_i18n.js:15
msgid "Server responded with {{statusCode}} code."
msgstr "Le serveur a répondu avec le code {{statusCode}}."

#: olc_webportalv2/static/js/dropzone_i18n.js:16
msgid "Cancel upload"
msgstr "Annuler le téléversement"

#: olc_webportalv2/static/js/dropzone_i18n.js:17
msgid "Upload canceled."
msgstr "Téléversement annulé."

#: olc_webportalv2/static/js/dropzone_i18n.js:18
