#: olc_webportalv2/static/admin/js/SelectFilter2.js:47
#, javascript-format
msgid "Available %s"
msgstr "%s disponibles"

#: olc_webportalv2/static/admin/js/SelectFilter2.js:53
#, javascript-format
msgid ""
"This is the list of available %s. You may choose some by selecting them in "
"the box below and then clicking the \"Choose\" arrow between the two boxes."
msgstr ""
"Voici la liste des %s disponibles. Pour en choisir, sélectionnez-les dans la "
"liste ci-dessous, puis cliquez sur la flèche « Choisir » entre les deux "
"listes."

#: olc_webportalv2/static/admin/js/SelectFilter2.js:69
#, javascript-format
msgid "Type into this box to filter down the list of available %s."
msgstr ""
"Saisissez du texte dans ce champ pour filtrer la liste des %s disponibles."

#: olc_webportalv2/static/admin/js/SelectFilter2.js:74
msgid "Filter"
msgstr "Filtrer"

#: olc_webportalv2/static/admin/js/SelectFilter2.js:78
msgid "Choose all"
msgstr "Tout sélectionner"

#: olc_webportalv2/static/admin/js/SelectFilter2.js:78
#, javascript-format
msgid "Click to choose all %s at once."
msgstr "Cliquez pour sélectionner tous les éléments de la liste %s."

#: olc_webportalv2/static/admin/js/SelectFilter2.js:84
msgid "Choose"
msgstr "Choisir"

#: olc_webportalv2/static/admin/js/SelectFilter2.js:86
msgid "Remove"
msgstr "Retirer"

#: olc_webportalv2/static/admin/js/SelectFilter2.js:92
#, javascript-format
msgid "Chosen %s"
msgstr "Sélection : %s"

#: olc_webportalv2/static/admin/js/SelectFilter2.js:98
#, javascript-format
msgid ""
"This is the list of chosen %s. You may remove some by selecting them in the "
"box below and then clicking the \"Remove\" arrow between the two boxes."
msgstr ""
"Voici la liste des %s sélectionnés. Pour en retirer, sélectionnez-les dans "
"la liste ci-dessous, puis cliquez sur la flèche « Retirer » entre les deux "
"listes."

#: olc_webportalv2/static/admin/js/SelectFilter2.js:108
msgid "Remove all"
msgstr "Tout retirer"

#: olc_webportalv2/static/admin/js/SelectFilter2.js:108
#, javascript-format
msgid "Click to remove all chosen %s at once."
msgstr "Cliquez pour retirer tous les éléments sélectionnés de la liste %s."

#: olc_webportalv2/static/admin/js/actions.js:48
#: olc_webportalv2/static/admin/js/actions.min.js:2
msgid "%(sel)s of %(cnt)s selected"
msgid_plural "%(sel)s of %(cnt)s selected"
msgstr[0] "Sélection : %(sel)s sur %(cnt)s"
msgstr[1] "Sélection : %(sel)s sur %(cnt)s"

#: olc_webportalv2/static/admin/js/actions.js:117
#: olc_webportalv2/static/admin/js/actions.min.js:5
msgid ""
"You have unsaved changes on individual editable fields. If you run an "
"action, your unsaved changes will be lost."
msgstr ""
"Certains champs modifiables ont des changements non enregistrés. Si vous "
"lancez une action, ces changements seront perdus."

#: olc_webportalv2/static/admin/js/actions.js:129
#: olc_webportalv2/static/admin/js/actions.min.js:5
msgid ""
"You have selected an action, but you haven't saved your changes to "
"individual fields yet. Please click OK to save. You'll need to re-run the "
"action."
msgstr ""
"Vous avez sélectionné une action, mais les changements apportés aux champs "
"individuels ne sont pas enregistrés. Cliquez sur OK pour les enregistrer, "
"puis relancez l’action."

#: olc_webportalv2/static/admin/js/actions.js:131
#: olc_webportalv2/static/admin/js/actions.min.js:6
msgid ""
"You have selected an action, and you haven't made any changes on individual "
"fields. You're probably looking for the Go button rather than the Save "
"button."
msgstr ""
"Vous avez sélectionné une action sans modifier les champs individuels. Vous "
"cherchez probablement le bouton « Exécuter » plutôt que le bouton "
"« Enregistrer »."

