#: olc_webportalv2/ampliseq/tasks.py:463
#, python-format
msgid ""
"Dear %(user)s,\n"
"Your AmpliSeq analysis, \"%(project)s\", is complete.\n"
"The AmpliSeq analysis results are available here: %(results)s.\n"
"The AmpliSeq report is available here: %(report)s.\n"
"The AmpliSeq trace is available here: %(trace)s.\n"
"The AmpliSeq timeline is available here: %(timeline)s\n"
"\n"
"Best regards,\n"
"The FoodPort development team"
msgstr ""
"Bonjour %(user)s,\n"
"Votre analyse AmpliSeq, « %(project)s », est terminée.\n"
"Les résultats de l’analyse AmpliSeq sont accessibles ici : %(results)s.\n"
"Le rapport AmpliSeq est accessible ici : %(report)s.\n"
"La trace d’exécution AmpliSeq est accessible ici : %(trace)s.\n"
"La chronologie AmpliSeq est accessible ici : %(timeline)s\n"
"\n"
"Cordialement,\n"
"L’équipe de développement de FoodPort"

