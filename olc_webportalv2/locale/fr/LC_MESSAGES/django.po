msgstr "Ajouter une autre cible"

#: olc_webportalv2/templates/primer_finder/validator_request.html:214
msgid "Run PrimerValidator"
msgstr "Lancer PrimerValidator"

#: olc_webportalv2/templates/primer_finder/validator_request.html:223
msgid "New target"
msgstr "Nouvelle cible"

#: olc_webportalv2/templates/primer_finder/validator_request.html:314
msgid "Frame shift: adjacent gene-reference hits are out of frame."
msgstr ""
"Décalage du cadre de lecture : les occurrences adjacentes de la séquence de "
"référence du gène ne sont pas dans le même cadre."

#: olc_webportalv2/templates/primer_finder/validator_request.html:315
msgid "Internal stop: the translated gene contains a premature stop codon."
msgstr "Codon stop interne : le gène traduit contient un codon stop prématuré."

#: olc_webportalv2/templates/primer_finder/validator_request.html:316
msgid "Partial contig end: the gene hit reaches the end of the contig."
msgstr ""
"Extrémité partielle du contig : la correspondance du gène atteint "
"l’extrémité du contig."

#: olc_webportalv2/templates/primer_finder/validator_request.html:317
msgid ""
"Extended gene: the hit spans the reference but has no expected terminal stop."
msgstr ""
"Gène prolongé : l’occurrence couvre la référence, mais ne comporte pas le "
"codon stop terminal attendu."

