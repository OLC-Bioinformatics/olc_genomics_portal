#: olc_webportalv2/filezone/forms.py:86
#, python-format
msgid ""
"%(object_type_cap)s name, %(container_name)s is invalid. %(object_type)s "
"names must be between 3 and 63 characters, start with a letter or number, "
"and contain only lowercase letters, numbers, and dashes. Dashes must be "
"surrounded by letters or numbers, and consecutive dashes are not allowed."
msgstr ""
"Le nom %(object_type_cap)s « %(container_name)s » est invalide. Les noms "
"%(object_type)s doivent comporter de 3 à 63 caractères, commencer par une "
"lettre ou un chiffre et ne contenir que des lettres minuscules, des chiffres "
"et des traits d’union. Les traits d’union doivent être précédés et suivis "
"d’une lettre ou d’un chiffre; les traits d’union consécutifs ne sont pas "
"permis."

